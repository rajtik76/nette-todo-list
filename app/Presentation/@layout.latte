<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link href="/css/app.css" rel="stylesheet">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Todo List</title>
</head>

<body class="bg-gray-100 min-h-screen">
	<div n:foreach="$flashes as $flash" n:class="flash, $flash->type, 'p-4 mb-4 rounded-lg text-center', $flash->type === 'success' ? 'bg-green-100 text-green-800' : ($flash->type === 'error' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800')">{$flash->message}</div>

	{include content}

	{block scripts}
	<script src="https://unpkg.com/nette-forms@3"></script>
	{/block}
</body>
</html>
